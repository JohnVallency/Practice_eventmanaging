# EventLMS backend — пример окружения. Скопируйте в .env и заполните.

PROJECT_NAME="EventLMS API"
DEBUG=false

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=eventlms
POSTGRES_PASSWORD=eventlms
POSTGRES_DB=eventlms
# DATABASE_URL задаётся целиком, чтобы переопределить сборку из POSTGRES_*:
# DATABASE_URL=postgresql+asyncpg://eventlms:eventlms@postgres:5432/eventlms

# CORS: список через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
